<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_mobikey_documents" model="ir.ui.view">
        <field name="name">product.template.form.mobikey.documents</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Quotation Details" name="mobikey_quotation_details">
                    <group>
                        <group>
                            <field name="mobikey_document_brand_id"/>
                            <field name="mobikey_show_product_details"/>
                            <field name="mobikey_default_warranty" placeholder="e.g. 2 years or 200,000 km, whichever comes first"/>
                        </group>
                    </group>
                    <group string="OBS (Product Sales Description)">
                        <field name="description_sale"
                               nolabel="1"
                               placeholder="Customer-facing observation printed below the main-product characteristics."/>
                    </group>
                    <group string="Ordered Specifications">
                        <field name="mobikey_specification_line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="value"/>
                                <field name="unit" optional="show"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
