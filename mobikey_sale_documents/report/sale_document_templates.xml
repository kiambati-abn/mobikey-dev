<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        The native sale report actions and mail templates are deliberately not
        replaced. These two inherited wrappers dispatch only orders with a
        selected Mobikey document template to the custom QWeb document.
        Orders without one continue to use Odoo's standard report.
    -->
    <template id="report_saleorder_raw_mobikey_dispatch" inherit_id="sale.report_saleorder_raw">
        <xpath expr="//t[@t-foreach='docs']" position="replace">
            <t t-foreach="docs" t-as="doc">
                <t t-if="doc.mobikey_document_template_id"
                   t-call="mobikey_sale_documents.report_sale_document"
                   t-lang="doc.partner_id.lang"/>
                <t t-else=""
                   t-call="sale.report_saleorder_document"
                   t-lang="doc.partner_id.lang"/>
            </t>
        </xpath>
    </template>

    <template id="report_saleorder_pro_forma_mobikey_dispatch"
              inherit_id="sale.report_saleorder_pro_forma">
        <xpath expr="//t[@t-foreach='docs']" position="replace">
            <t t-foreach="docs" t-as="doc">
                <t t-if="doc.mobikey_document_template_id"
                   t-call="mobikey_sale_documents.report_sale_document"
                   t-lang="doc.partner_id.lang"/>
                <t t-else=""
                   t-call="sale.report_saleorder_document"
                   t-lang="doc.partner_id.lang"/>
            </t>
        </xpath>
    </template>

    <template id="report_sale_document_layout">
        <t t-set="template" t-value="doc.mobikey_document_template_id"/>
        <t t-set="company" t-value="doc.company_id"/>
        <t t-set="issuer_logo" t-value="template.issuer_logo or company.logo"/>
        <t t-set="brands" t-value="doc._get_mobikey_report_brands()"/>
        <t t-set="accent_tint" t-value="template._get_mobikey_accent_tint()"/>
        <t t-set="logo_dimensions"
           t-value="template._get_mobikey_logo_dimensions(len(brands))"/>

        <div t-attf-class="header o_company_#{company.id}_layout"
             style="font-family: Arial, Helvetica, sans-serif; border: 0 !important;">
            <style>
                table.mobikey-borderless,
                table.mobikey-borderless tr,
                table.mobikey-borderless th,
                table.mobikey-borderless td {
                    border: 0 !important;
                    outline: 0 !important;
                    box-shadow: none !important;
                }
            </style>
            <table class="mobikey-borderless" style="width: 100%; border-collapse: collapse;">
                <tr>
                    <td t-att-style="'width: 50%; height: ' + str(logo_dimensions['header_height']) + 'mm; vertical-align: middle; border: 0;'">
                        <img t-if="issuer_logo"
                             t-att-src="image_data_uri(issuer_logo)"
                             alt="Dealer logo"
                             t-att-style="'display: block; max-width: %smm; max-height: %smm; object-fit: contain;' % (logo_dimensions['issuer_width'], logo_dimensions['issuer_height'])"/>
                    </td>
                    <td t-att-style="'width: 50%; height: ' + str(logo_dimensions['header_height']) + 'mm; text-align: right; vertical-align: middle; white-space: normal; border: 0;'">
                        <t t-foreach="brands" t-as="brand">
                            <img t-if="brand.logo"
                                 t-att-src="image_data_uri(brand.logo)"
                                 t-att-alt="brand.name"
                                 t-att-title="brand.name"
                                 t-att-style="'display: inline-block; max-width: %smm; max-height: %smm; margin: 0 0 1mm 2mm; object-fit: contain; vertical-align: middle;' % (logo_dimensions['brand_width'], logo_dimensions['brand_height'])"/>
                        </t>
                    </td>
                </tr>
            </table>
            <div style="height: 2mm;"/>
        </div>

        <div t-attf-class="article o_company_#{company.id}_layout"
             t-att-data-oe-model="doc and doc._name"
             t-att-data-oe-id="doc and doc.id"
             t-att-data-oe-lang="doc and doc.env.context.get('lang')"
             style="font-family: Arial, Helvetica, sans-serif; font-size: 10pt; line-height: 1.3;">
            <t t-out="0"/>
        </div>

        <div t-attf-class="footer o_company_#{company.id}_layout"
             style="font-family: Arial, Helvetica, sans-serif; font-size: 8.5pt; line-height: 1.2;">
            <style>
                .mobikey-footer-note,
                .mobikey-footer-note p {
                    display: inline;
                    margin: 0;
                    padding: 0;
                }
                table.mobikey-borderless,
                table.mobikey-borderless tr,
                table.mobikey-borderless th,
                table.mobikey-borderless td {
                    border: 0 !important;
                    outline: 0 !important;
                    box-shadow: none !important;
                }
            </style>
            <div style="padding-top: 1mm;">
                <table class="mobikey-borderless" style="width: 100%; border-collapse: collapse;">
                    <tr>
                        <td style="width: 82%; vertical-align: bottom; border: 0; padding: 0;">
                            <strong style="font-size: 9pt;" t-field="company.name"/>
                            <span t-if="company.street"> · <span t-field="company.street"/></span><span t-if="company.street2">, <span t-field="company.street2"/></span><span t-if="company.zip or company.city"> · <span t-if="company.zip" t-field="company.zip"/> <span t-if="company.city" t-field="company.city"/></span><span t-if="company.country_id"> · <span t-field="company.country_id.name"/></span>
                            <br/>
                            <span t-if="company.phone"><span t-field="company.phone"/></span><span t-if="company.email"> · <span t-field="company.email"/></span>
                            <span t-if="company.vat">
                                · <t t-out="company.country_id.vat_label or 'Tax ID'"/>:
                                <span t-field="company.vat"/>
                            </span>
                            <span t-if="not is_html_empty(template.footer_note)"> · <span class="mobikey-footer-note" t-field="template.footer_note"/></span>
                        </td>
                        <td style="width: 18%; text-align: right; vertical-align: bottom; white-space: nowrap; border: 0; padding: 0;">
                            <span t-field="doc.name"/> · Page <span class="page"/> / <span class="topage"/>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </template>

    <template id="report_sale_document">
        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
        <t t-set="template" t-value="doc.mobikey_document_template_id"/>
        <t t-set="is_proforma" t-value="doc.env.context.get('proforma', False)"/>
        <t t-call="mobikey_sale_documents.report_sale_document_layout">
            <div class="page">
                <style>
                    table.mobikey-borderless,
                    table.mobikey-borderless tr,
                    table.mobikey-borderless th,
                    table.mobikey-borderless td {
                        border: 0 !important;
                        outline: 0 !important;
                        box-shadow: none !important;
                    }
                    .mobikey-section-title {
                        padding: 1.4mm 1.8mm;
                        margin: 5mm 0 2.5mm 0;
                        font-size: 10.75pt;
                        line-height: 1.2;
                        font-weight: bold;
                        text-transform: uppercase;
                        page-break-after: avoid;
                        break-after: avoid-page;
                    }
                    .mobikey-label {
                        font-weight: bold;
                        white-space: nowrap;
                    }
                    .mobikey-table {
                        width: 100%;
                        border-collapse: collapse;
                    }
                    .mobikey-table th,
                    .mobikey-table td {
                        border: 0 !important;
                        padding: 1.1mm 1.4mm;
                        vertical-align: top;
                    }
                    .mobikey-table th {
                        font-weight: bold;
                    }
                    .mobikey-avoid-break {
                        page-break-inside: avoid;
                    }
                    .mobikey-muted {
                        color: #5f6368;
                    }
                    .mobikey-spec-grid {
                        width: 100%;
                        border-collapse: collapse;
                        table-layout: fixed;
                    }
                    .mobikey-spec-grid td {
                        border: 0 !important;
                        padding: 0.9mm 1.3mm;
                        line-height: 1.3;
                        vertical-align: top;
                        page-break-inside: avoid;
                    }
                    .mobikey-product-title {
                        margin: 2.5mm 0 1.8mm 0;
                        padding: 1.4mm 1.8mm;
                        font-size: 11.25pt;
                        line-height: 1.2;
                        font-weight: bold;
                        page-break-after: avoid;
                        break-after: avoid-page;
                    }
                    .mobikey-warranty {
                        margin-top: 2.2mm;
                        page-break-inside: avoid;
                        white-space: pre-line;
                    }
                    .mobikey-observation-table {
                        width: 100%;
                        margin-top: 2mm;
                        border: 0 !important;
                        border-collapse: collapse;
                        page-break-inside: avoid;
                    }
                    .mobikey-observation-table td {
                        border: 0 !important;
                        padding: 1.5mm 1.8mm;
                        line-height: 1.35;
                        vertical-align: top;
                    }
                    .mobikey-commercial-table thead th {
                        border: 0 !important;
                        border-bottom: 0.25mm solid #777777 !important;
                    }
                    .mobikey-commercial-table tbody td {
                        border: 0 !important;
                        border-bottom: 0.1mm solid #e8e8e8 !important;
                    }
                    .mobikey-compact-terms td {
                        border: 0 !important;
                        padding: 1mm 1.4mm;
                    }
                    .mobikey-bank-group {
                        margin-bottom: 3mm;
                        page-break-inside: avoid;
                    }
                    .mobikey-bank-accounts td {
                        border: 0 !important;
                        padding: 0.8mm 1.2mm;
                    }
                    .mobikey-totals-table td {
                        border: 0 !important;
                        padding: 0.7mm 1mm !important;
                        color: #111827 !important;
                    }
                    .mobikey-totals-table tr.o_total td,
                    .mobikey-totals-table tr.o_total strong {
                        color: inherit !important;
                    }
                    .mobikey-terms {
                        font-size: 9pt;
                        line-height: 1.3;
                        text-align: justify;
                        break-before: avoid-page;
                    }
                    .mobikey-terms p {
                        margin: 0 0 1.8mm 0;
                    }
                    .mobikey-terms h1,
                    .mobikey-terms h2,
                    .mobikey-terms h3,
                    .mobikey-terms h4 {
                        margin: 2.5mm 0 1.2mm 0;
                        font-size: 9.75pt;
                        line-height: 1.2;
                    }
                </style>

                <table class="mobikey-table mobikey-borderless" style="margin-top: 2mm;">
                    <tr>
                        <td style="width: 46%; padding-left: 0;">
                            <div t-att-style="'font-size: 13pt; line-height: 1.2; font-weight: bold; text-transform: uppercase; color: %s;' % template.primary_color">
                                <t t-if="is_proforma">Proforma Invoice</t>
                                <t t-elif="doc.state in ('draft', 'sent')">Quotation</t>
                                <t t-else="">Sales Order</t>
                            </div>
                            <div><span class="mobikey-label">Reference:</span> <span t-field="doc.name"/></div>
                            <div t-if="doc.client_order_ref">
                                <span class="mobikey-label">Customer Reference:</span>
                                <span t-field="doc.client_order_ref"/>
                            </div>
                            <div><span class="mobikey-label">Salesperson:</span> <span t-field="doc.user_id"/></div>
                            <div t-if="doc.user_id.phone">
                                <span class="mobikey-label">Mobile:</span> <span t-field="doc.user_id.phone"/>
                            </div>
                            <div t-if="doc.user_id.email">
                                <span class="mobikey-label">Email:</span> <span t-field="doc.user_id.email"/>
                            </div>
                        </td>
                        <td style="width: 3%; padding: 0;"/>
                        <td t-att-style="'width: 51%; padding: 2mm; background: ' + accent_tint + ';'">
                            <div class="mobikey-label">Customer</div>
                            <div t-field="doc.partner_id"
                                 t-options='{"widget": "contact", "fields": ["name", "address", "phone", "email"], "no_marker": True}'/>
                            <div t-if="doc.partner_id.vat">
                                <span class="mobikey-label">
                                    <t t-out="doc.company_id.account_fiscal_country_id.vat_label or 'Tax ID'"/>:
                                </span>
                                <span t-field="doc.partner_id.vat"/>
                            </div>
                        </td>
                    </tr>
                </table>

                <div style="text-align: right; margin-top: 3mm; line-height: 1.3;">
                    <div t-if="doc._get_mobikey_issuer_location()">
                        <span t-out="doc._get_mobikey_issuer_location()"/>
                    </div>
                    <span class="mobikey-label"><t t-if="is_proforma">Issue Date</t><t t-else="">Quotation Date</t>:</span>
                    <span t-field="doc.date_order" t-options="{'widget': 'date'}"/>
                </div>

                <t t-set="characteristic_lines" t-value="doc._get_mobikey_characteristic_product_lines()"/>
                <div t-if="characteristic_lines"
                     class="mobikey-section-title"
                     t-att-style="'background: %s; color: #FFFFFF;' % template.primary_color">
                    1. Description and Product Characteristics
                </div>

                <t t-foreach="characteristic_lines" t-as="characteristic_line">
                    <div style="margin-bottom: 4mm;">
                        <div class="mobikey-product-title"
                             t-att-style="'color: %s; background: %s;' % (template.primary_color, accent_tint)">
                            <span t-out="characteristic_line.mobikey_product_model or characteristic_line.product_id.display_name"/>
                        </div>
                        <t t-set="detail_rows" t-value="characteristic_line._get_mobikey_detail_rows()"/>
                        <table t-if="detail_rows" class="mobikey-spec-grid mobikey-borderless">
                            <t t-foreach="detail_rows" t-as="detail_row">
                                <tr>
                                    <td style="width: 18%; text-align: right;" class="mobikey-label">
                                        <t t-out="detail_row[0]['label']"/>
                                    </td>
                                    <td style="width: 32%;">
                                        <t t-out="detail_row[0]['value']"/>
                                    </td>
                                    <td style="width: 18%; text-align: right;" class="mobikey-label">
                                        <t t-if="detail_row[1]" t-out="detail_row[1]['label']"/>
                                    </td>
                                    <td style="width: 32%;">
                                        <t t-if="detail_row[1]" t-out="detail_row[1]['value']"/>
                                    </td>
                                </tr>
                            </t>
                        </table>
                        <t t-set="observation" t-value="characteristic_line._get_mobikey_report_observation()"/>
                        <table t-if="observation" class="mobikey-observation-table mobikey-borderless">
                            <tr>
                                <td class="mobikey-label" style="width: 18%; text-align: right;">
                                    OBS:
                                </td>
                                <td t-att-style="'width: 82%; background: ' + accent_tint + '; white-space: pre-line;'">
                                    <span t-out="observation"/>
                                </td>
                            </tr>
                        </table>
                        <div t-if="characteristic_line.mobikey_warranty" class="mobikey-warranty">
                            <span class="mobikey-label">Warranty Terms: </span>
                            <span t-out="characteristic_line.mobikey_warranty"/>
                        </div>
                    </div>
                </t>

                <div class="mobikey-section-title"
                     t-att-style="'background: %s; color: #FFFFFF;' % template.primary_color">
                    2. Commercial Conditions
                </div>

                <t t-set="commercial_lines" t-value="doc._get_order_lines_to_report()"/>
                <t t-set="display_discount" t-value="any(line.discount &gt; 0 for line in commercial_lines if not line.display_type)"/>
                <t t-set="display_taxes" t-value="any(line._has_taxes() for line in commercial_lines if not line.display_type)"/>
                <table class="mobikey-table mobikey-commercial-table">
                    <thead t-att-style="'background: %s;' % template.accent_color">
                        <tr>
                            <th style="text-align: left;">Description</th>
                            <th style="text-align: right; white-space: nowrap;">Quantity</th>
                            <th style="text-align: right; white-space: nowrap;">Unit Price</th>
                            <th t-if="display_discount" style="text-align: right;">Disc.%</th>
                            <th t-if="display_taxes" style="text-align: right;">Taxes</th>
                            <th style="text-align: right; white-space: nowrap;">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="commercial_lines" t-as="line">
                            <tr t-if="line.display_type in ('line_section', 'line_subsection')"
                                t-att-style="'font-weight: bold; color: %s;' % template.primary_color">
                                <td colspan="99"><span t-field="line.name"/></td>
                            </tr>
                            <tr t-elif="line.display_type == 'line_note'" style="font-style: italic;">
                                <td colspan="99"><span t-field="line.name"/></td>
                            </tr>
                            <tr t-else="">
                                <td><span t-out="line._get_mobikey_commercial_description()"/></td>
                                <td style="text-align: right; white-space: nowrap;">
                                    <span t-field="line.product_uom_qty"/>
                                    <span t-field="line.product_uom_id"/>
                                </td>
                                <td style="text-align: right; white-space: nowrap;">
                                    <span t-if="line.discount &lt; 0"
                                          t-out="(1 - line.discount / 100.0) * line.price_unit"
                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    <span t-else=""
                                          t-out="line.price_unit"
                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                </td>
                                <td t-if="display_discount" style="text-align: right;">
                                    <span t-if="line.discount" t-field="line.discount"/>
                                </td>
                                <td t-if="display_taxes" style="text-align: right;">
                                    <t t-out="', '.join(tax.tax_label for tax in line.tax_ids if tax.tax_label)"/>
                                </td>
                                <td style="text-align: right; white-space: nowrap;">
                                    <span t-if="doc.company_price_include == 'tax_included'"
                                          t-field="line.price_total"/>
                                    <span t-else="" t-field="line.price_subtotal"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div class="clearfix" style="margin-top: 1.5mm;">
                    <div style="width: 45%; float: right;">
                        <table class="table table-borderless mobikey-totals-table"
                               t-att-style="'width: 100%; font-size: 10pt; color: ' + template.primary_color + ';'">
                            <tr t-if="doc.mobikey_discount_total">
                                <td>Aggregate Line Discount</td>
                                <td style="text-align: right;">
                                    <span t-field="doc.mobikey_discount_total"/>
                                </td>
                            </tr>
                            <t t-call="sale.document_tax_totals">
                                <t t-set="tax_totals" t-value="doc.tax_totals"/>
                                <t t-set="currency" t-value="doc.currency_id"/>
                            </t>
                        </table>
                    </div>
                </div>

                <div style="clear: both;"/>
                <div class="mobikey-section-title"
                     t-att-style="'background: %s; color: #FFFFFF;' % template.primary_color">
                    3. Payment, Delivery and Validity
                </div>
                <table class="mobikey-table mobikey-compact-terms mobikey-avoid-break mobikey-borderless">
                    <tr t-if="doc.payment_term_id">
                        <td class="mobikey-label" style="width: 26%;">Payment Conditions</td>
                        <td><span t-field="doc.payment_term_id"/></td>
                    </tr>
                    <tr t-if="doc.mobikey_delivery_terms">
                        <td class="mobikey-label">Delivery Terms</td>
                        <td><span t-field="doc.mobikey_delivery_terms"/></td>
                    </tr>
                    <tr t-if="doc.commitment_date">
                        <td class="mobikey-label">Expected Delivery Date</td>
                        <td><span t-field="doc.commitment_date" t-options="{'widget': 'date'}"/></td>
                    </tr>
                    <tr t-if="doc.validity_date">
                        <td class="mobikey-label"><t t-if="is_proforma">Proforma Validity</t><t t-else="">Quotation Validity</t></td>
                        <td><span t-field="doc.validity_date"/></td>
                    </tr>
                </table>
                <div t-if="doc.payment_term_id and not is_html_empty(doc.payment_term_id.note)" style="margin-top: 1.5mm;">
                    <span t-field="doc.payment_term_id.note"/>
                </div>

                <div t-if="doc.mobikey_bank_account_ids"
                     class="mobikey-section-title"
                     t-att-style="'background: %s; color: #FFFFFF;' % template.primary_color">
                    4. Bank References
                </div>
                <t t-foreach="doc._get_mobikey_bank_groups()" t-as="bank_group">
                    <div class="mobikey-bank-group">
                        <table class="mobikey-table mobikey-borderless" style="table-layout: fixed;">
                            <tr t-att-style="'background: %s;' % accent_tint">
                                <td style="width: 48%; border: 0;">
                                    <strong t-out="bank_group['bank_name']"/>
                                    <span t-if="bank_group['bank_city']" class="mobikey-muted">
                                        · <span t-out="bank_group['bank_city']"/>
                                    </span>
                                </td>
                                <td style="width: 30%; border: 0;">
                                    <span t-if="bank_group['holder_names']">
                                        <span class="mobikey-label">Holder: </span>
                                        <span t-out="', '.join(bank_group['holder_names'])"/>
                                    </span>
                                </td>
                                <td style="width: 22%; border: 0; text-align: right;">
                                    <span t-if="bank_group['bic']">
                                        <span class="mobikey-label">SWIFT/BIC: </span>
                                        <span t-out="bank_group['bic']"/>
                                    </span>
                                </td>
                            </tr>
                        </table>
                        <table class="mobikey-bank-accounts mobikey-borderless" style="width: 100%; border-collapse: collapse;">
                            <tr t-foreach="bank_group['accounts']" t-as="account_value">
                                <td style="width: 48%;"/>
                                <td style="width: 12%; font-weight: bold; text-align: right;">
                                    <span t-out="account_value['currency'] or '—'"/>
                                </td>
                                <td style="width: 40%;">
                                    <span t-out="account_value['number']"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>

                <div t-if="not is_html_empty(doc.mobikey_terms_html) or not is_html_empty(doc.note)"
                     class="mobikey-section-title"
                     t-att-style="'background: %s; color: #FFFFFF;' % template.primary_color">
                    5. Terms and Conditions
                </div>
                <div t-if="not is_html_empty(doc.mobikey_terms_html)"
                     t-field="doc.mobikey_terms_html"
                     class="mobikey-terms"/>
                <div t-elif="not is_html_empty(doc.note)"
                     t-field="doc.note"
                     class="mobikey-terms"/>

                <div class="mobikey-section-title"
                     t-att-style="'background: %s; color: #FFFFFF;' % template.primary_color">
                    6. Signatures
                </div>
                <table class="mobikey-table mobikey-avoid-break mobikey-borderless" style="margin-top: 5mm;">
                    <tr>
                        <td style="width: 33%; text-align: center; border-bottom: 0;">
                            <img t-if="template.signatory_1_image"
                                 t-att-src="image_data_uri(template.signatory_1_image)"
                                 alt="First signature"
                                 style="max-width: 150px; max-height: 55px; object-fit: contain;"/>
                            <div style="border-top: 1px solid #333; margin: 8px 12px 3px 12px; padding-top: 3px;">
                                <strong t-if="template.signatory_1_id" t-field="template.signatory_1_id.name"/>
                                <strong t-else="" t-field="doc.user_id.name"/>
                            </div>
                            <div t-if="template.signatory_1_title" t-field="template.signatory_1_title"/>
                            <div t-else="" t-field="doc.company_id.name"/>
                        </td>
                        <td t-if="template.signatory_2_id or template.signatory_2_image"
                            style="width: 33%; text-align: center; border-bottom: 0;">
                            <img t-if="template.signatory_2_image"
                                 t-att-src="image_data_uri(template.signatory_2_image)"
                                 alt="Second signature"
                                 style="max-width: 150px; max-height: 55px; object-fit: contain;"/>
                            <div style="border-top: 1px solid #333; margin: 8px 12px 3px 12px; padding-top: 3px;">
                                <strong t-if="template.signatory_2_id" t-field="template.signatory_2_id.name"/>
                            </div>
                            <div t-if="template.signatory_2_title" t-field="template.signatory_2_title"/>
                        </td>
                        <td t-if="template.show_customer_signature"
                            style="width: 33%; text-align: center; border-bottom: 0; vertical-align: bottom;">
                            <img t-if="doc.signature and doc.env.context.get('sale_include_signature')"
                                 t-att-src="image_data_uri(doc.signature)"
                                 alt="Customer signature"
                                 style="max-width: 150px; max-height: 55px; object-fit: contain;"/>
                            <div t-else="" style="height: 55px;"/>
                            <div style="border-top: 1px solid #333; margin: 8px 12px 3px 12px; padding-top: 3px;">
                                <strong t-if="doc.signed_by and doc.env.context.get('sale_include_signature')"
                                        t-field="doc.signed_by"/>
                                <strong t-else="" t-field="doc.partner_id.name"/>
                            </div>
                            <div>Customer</div>
                        </td>
                    </tr>
                </table>
            </div>
        </t>
    </template>
</odoo>
