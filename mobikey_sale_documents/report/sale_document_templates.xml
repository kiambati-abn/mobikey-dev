<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        The native sale report actions and mail templates are deliberately not
        replaced. These two inherited wrappers dispatch only orders with a
        selected Mobikey document template to the custom QWeb document.
        Orders without one continue to use Odoo's standard report.
    -->
    <template id="report_saleorder_raw_mobikey_dispatch" inherit_id="sale.report_saleorder_raw">
        <xpath expr="//t[@t-foreach='docs']" position="replace">
            <t t-foreach="docs" t-as="doc">
                <t t-if="doc.mobikey_document_template_id"
                   t-call="mobikey_sale_documents.report_sale_document"
                   t-lang="doc.partner_id.lang"/>
                <t t-else=""
                   t-call="sale.report_saleorder_document"
                   t-lang="doc.partner_id.lang"/>
            </t>
        </xpath>
    </template>

    <template id="report_saleorder_pro_forma_mobikey_dispatch"
              inherit_id="sale.report_saleorder_pro_forma">
        <xpath expr="//t[@t-foreach='docs']" position="replace">
            <t t-foreach="docs" t-as="doc">
                <t t-if="doc.mobikey_document_template_id"
                   t-call="mobikey_sale_documents.report_sale_document"
                   t-lang="doc.partner_id.lang"/>
                <t t-else=""
                   t-call="sale.report_saleorder_document"
                   t-lang="doc.partner_id.lang"/>
            </t>
        </xpath>
    </template>

    <template id="report_section_lead">
        <div class="mobikey-section-lead">
            <t t-out="0"/>
        </div>
    </template>

    <template id="report_specification_row">
        <div class="mobikey-spec-row"
             t-attf-style="background: #{accent_stripe if detail_row_index % 2 else '#FFFFFF'};">
            <div class="mobikey-spec-cell">
                <span class="mobikey-spec-label">
                    <t t-out="detail_row[0]['label']"/>
                </span>
                <span class="mobikey-spec-value">
                    <t t-out="detail_row[0]['value']"/>
                </span>
            </div>
            <div class="mobikey-spec-cell">
                <span class="mobikey-spec-label">
                    <t t-if="detail_row[1]" t-out="detail_row[1]['label']"/>
                </span>
                <span class="mobikey-spec-value">
                    <t t-if="detail_row[1]" t-out="detail_row[1]['value']"/>
                </span>
            </div>
        </div>
    </template>

    <template id="report_product_observation">
        <div class="mobikey-observation"
             t-attf-style="background: #{light_background};">
            <div class="mobikey-observation-label">OBS:</div>
            <div class="mobikey-observation-value">
                <span t-out="observation"/>
            </div>
        </div>
    </template>

    <template id="report_product_characteristics">
        <t t-set="detail_rows" t-value="characteristic_line._get_mobikey_detail_rows()"/>
        <t t-set="observation" t-value="characteristic_line._get_mobikey_report_observation()"/>
        <t t-call="mobikey_sale_documents.report_section_lead">
            <div t-if="product_section_title"
                 class="mobikey-section-title"
                 t-attf-style="background: #{primary_color}; color: #{primary_foreground};">
                <t t-out="product_section_title"/>
            </div>
            <div class="mobikey-product-title"
                 t-attf-style="color: #{light_foreground}; background: #{light_background};">
                <span t-out="characteristic_line.mobikey_product_model or characteristic_line.product_id.display_name"/>
            </div>
            <div t-if="detail_rows" class="mobikey-spec-grid">
                <t t-set="detail_row" t-value="detail_rows[0]"/>
                <t t-set="detail_row_index" t-value="0"/>
                <t t-call="mobikey_sale_documents.report_specification_row"/>
            </div>
            <t t-elif="observation" t-call="mobikey_sale_documents.report_product_observation"/>
            <div t-elif="characteristic_line.mobikey_warranty" class="mobikey-warranty">
                <span class="mobikey-label">Warranty Terms: </span>
                <span t-out="characteristic_line.mobikey_warranty"/>
            </div>
        </t>
        <div t-if="detail_rows[1:]" class="mobikey-spec-grid">
            <t t-foreach="detail_rows[1:]" t-as="detail_row">
                <t t-set="detail_row_index" t-value="detail_row_index + 1"/>
                <t t-call="mobikey_sale_documents.report_specification_row"/>
            </t>
        </div>
        <t t-if="observation and detail_rows"
           t-call="mobikey_sale_documents.report_product_observation"/>
        <div t-if="characteristic_line.mobikey_warranty and (detail_rows or observation)"
             class="mobikey-warranty">
            <span class="mobikey-label">Warranty Terms: </span>
            <span t-out="characteristic_line.mobikey_warranty"/>
        </div>
    </template>

    <template id="report_commercial_line">
        <tr t-if="line.display_type in ('line_section', 'line_subsection')"
            class="mobikey-commercial-section"
            t-attf-style="font-weight: bold; color: #{primary_color};">
            <td colspan="99"><span t-field="line.name"/></td>
        </tr>
        <tr t-elif="line.display_type == 'line_note'"
            class="mobikey-commercial-note"
            t-attf-style="font-style: italic; color: #{muted_color};">
            <td colspan="99"><span t-field="line.name"/></td>
        </tr>
        <tr t-else=""
            class="mobikey-commercial-item"
            t-attf-style="background: #{accent_stripe if commercial_line_index % 2 else '#FFFFFF'};">
            <td class="mobikey-commercial-description">
                <span t-out="line._get_mobikey_commercial_description()"/>
            </td>
            <td class="mobikey-number">
                <span t-field="line.product_uom_qty"/>
                <span t-field="line.product_uom_id"/>
            </td>
            <td class="mobikey-number">
                <span t-if="line.discount &lt; 0"
                      t-out="(1 - line.discount / 100.0) * line.price_unit"
                      t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                <span t-else=""
                      t-out="line.price_unit"
                      t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
            </td>
            <td t-if="display_discount" class="mobikey-number">
                <span t-if="line.discount" t-field="line.discount"/>
            </td>
            <td t-if="display_taxes" class="mobikey-number">
                <t t-out="', '.join(tax.tax_label for tax in line.tax_ids if tax.tax_label)"/>
            </td>
            <td class="mobikey-number">
                <span t-if="doc.company_price_include == 'tax_included'"
                      t-field="line.price_total"/>
                <span t-else="" t-field="line.price_subtotal"/>
            </td>
        </tr>
    </template>

    <template id="report_commercial_columns">
        <colgroup>
            <col t-attf-style="width: #{40 + (0 if display_discount else 8) + (0 if display_taxes else 10)}%;"/>
            <col style="width: 12%;"/>
            <col style="width: 15%;"/>
            <col t-if="display_discount" style="width: 8%;"/>
            <col t-if="display_taxes" style="width: 10%;"/>
            <col style="width: 15%;"/>
        </colgroup>
    </template>

    <template id="report_payment_row">
        <div class="mobikey-payment-row"
             t-attf-style="background: #{accent_stripe if payment_row_index % 2 else '#FFFFFF'};">
            <div class="mobikey-payment-label">
                <span t-out="payment_row[1]"/>
            </div>
            <div class="mobikey-payment-value">
                <span t-if="payment_row[0] == 'payment'" t-field="doc.payment_term_id"/>
                <span t-elif="payment_row[0] == 'delivery_terms'" t-field="doc.mobikey_delivery_terms"/>
                <span t-elif="payment_row[0] == 'delivery_date'"
                      t-field="doc.commitment_date"
                      t-options="{'widget': 'date'}"/>
                <span t-else="" t-field="doc.validity_date"/>
            </div>
        </div>
    </template>

    <template id="report_bank_group">
        <div class="mobikey-bank-group" t-attf-style="background: #{accent_stripe};">
            <div class="mobikey-bank-meta">
                <div class="mobikey-bank-name" t-attf-style="color: #{primary_color};">
                    <span t-out="bank_group['bank_name']"/>
                </div>
                <div t-if="bank_group['holder_names']" class="mobikey-bank-detail">
                    <span class="mobikey-label">Account Holder: </span>
                    <span t-out="', '.join(bank_group['holder_names'])"/>
                </div>
                <div t-if="bank_group['bic']" class="mobikey-bank-detail">
                    <span class="mobikey-label">SWIFT/BIC: </span>
                    <span t-out="bank_group['bic']"/>
                </div>
                <div t-if="bank_group['bank_city']" class="mobikey-bank-detail">
                    <span class="mobikey-label">Branch / City: </span>
                    <span t-out="bank_group['bank_city']"/>
                </div>
            </div>
            <div class="mobikey-bank-accounts">
                <div class="mobikey-bank-accounts-title" t-attf-style="color: #{primary_color};">
                    Account Numbers
                </div>
                <div t-foreach="bank_group['accounts']"
                     t-as="account_value"
                     class="mobikey-bank-account-row">
                    <div class="mobikey-bank-account-currency" t-attf-style="color: #{primary_color};">
                        <span t-out="account_value['currency'] or '—'"/>
                    </div>
                    <div class="mobikey-bank-account-number">
                        <span t-out="account_value['number']"/>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="report_sale_document_layout">
        <t t-set="template" t-value="doc.mobikey_document_template_id"/>
        <t t-set="company" t-value="doc.company_id"/>
        <t t-set="palette" t-value="template._get_mobikey_palette()"/>
        <t t-set="primary_color" t-value="palette['primary']"/>
        <t t-set="body_color" t-value="palette['body']"/>
        <t t-set="light_background" t-value="palette['light_background']"/>
        <t t-set="issuer_logo" t-value="template.issuer_logo or company.logo"/>
        <t t-set="brands" t-value="doc._get_mobikey_report_brands()"/>
        <t t-set="document_status" t-value="doc._get_mobikey_watermark_text()"/>
        <t t-set="logo_dimensions"
           t-value="template._get_mobikey_logo_dimensions(len(brands))"/>

        <div t-attf-class="header o_company_#{company.id}_layout"
             style="font-family: Arial, Helvetica, sans-serif; border: 0 !important; outline: 0 !important; box-shadow: none !important;">
            <style>
                .mobikey-header-row,
                .mobikey-header-logo {
                    border: 0 !important;
                    outline: 0 !important;
                    box-shadow: none !important;
                }
                .mobikey-header-row {
                    width: 100%;
                    font-size: 0;
                    white-space: nowrap;
                }
                .mobikey-header-logo {
                    display: inline-block;
                    width: 50%;
                    vertical-align: middle;
                }
            </style>
            <div class="mobikey-header-row">
                <div class="mobikey-header-logo"
                     t-attf-style="height: #{logo_dimensions['header_height']}mm; line-height: #{logo_dimensions['header_height']}mm;">
                    <img t-if="issuer_logo"
                         t-att-src="image_data_uri(issuer_logo)"
                         alt="Dealer logo"
                         t-attf-style="display: inline-block; max-width: #{logo_dimensions['issuer_width']}mm; max-height: #{logo_dimensions['issuer_height']}mm; object-fit: contain; vertical-align: middle;"/>
                </div>
                <div class="mobikey-header-logo"
                     t-attf-style="height: #{logo_dimensions['header_height']}mm; line-height: #{logo_dimensions['header_height']}mm; text-align: right;">
                    <div style="display: inline-block; width: 100%; line-height: normal; vertical-align: middle; white-space: normal;">
                        <t t-foreach="brands" t-as="brand">
                            <img t-if="brand.logo"
                                 t-att-src="image_data_uri(brand.logo)"
                                 t-att-alt="brand.name"
                                 t-att-title="brand.name"
                                 t-attf-style="display: inline-block; max-width: #{logo_dimensions['brand_width']}mm; max-height: #{logo_dimensions['brand_height']}mm; margin-left: 2mm; object-fit: contain; vertical-align: middle;"/>
                        </t>
                    </div>
                </div>
            </div>
        </div>

        <div t-attf-class="article o_company_#{company.id}_layout"
             t-att-data-oe-model="doc and doc._name"
             t-att-data-oe-id="doc and doc.id"
             t-att-data-oe-lang="doc and doc.env.context.get('lang')"
             t-attf-style="font-family: Arial, Helvetica, sans-serif; font-size: 10pt; line-height: 1.3; color: #{body_color};">
            <t t-out="0"/>
        </div>

        <div t-attf-class="footer o_company_#{company.id}_layout"
             t-attf-style="min-height: 26mm; padding-top: 4mm; box-sizing: border-box; font-family: Arial, Helvetica, sans-serif; font-size: 10pt; line-height: 1.35; color: #{body_color}; background: #FFFFFF !important; border: 0 !important; outline: 0 !important; box-shadow: none !important;">
            <style>
                .mobikey-footer-note,
                .mobikey-footer-note p {
                    display: inline;
                    margin: 0;
                    padding: 0;
                }
                .mobikey-footer-row,
                .mobikey-footer-details,
                .mobikey-footer-page {
                    border: 0 !important;
                    outline: 0 !important;
                    box-shadow: none !important;
                }
                .mobikey-footer-row {
                    width: 100%;
                    font-size: 0;
                }
                .mobikey-footer-details,
                .mobikey-footer-page {
                    display: inline-block;
                    vertical-align: bottom;
                }
                .mobikey-footer-details {
                    width: 78%;
                    font-size: 10pt;
                }
                .mobikey-footer-page {
                    width: 22%;
                    font-size: 9.5pt;
                    text-align: right;
                    white-space: nowrap;
                }
                .mobikey-footer-status {
                    margin-bottom: 0.7mm;
                    font-size: 9.5pt;
                    line-height: 1.1;
                    font-weight: bold;
                    letter-spacing: 0.35mm;
                    text-transform: uppercase;
                }
            </style>
            <div t-attf-style="border-top: 0.35mm solid #{primary_color}; padding-top: 3.5mm;">
                <div class="mobikey-footer-row">
                    <div class="mobikey-footer-details">
                        <strong style="font-size: 10.5pt;" t-field="company.name"/>
                        <span t-if="company.street"> · <span t-field="company.street"/></span><span t-if="company.street2">, <span t-field="company.street2"/></span><span t-if="company.zip or company.city"> · <span t-if="company.zip" t-field="company.zip"/> <span t-if="company.city" t-field="company.city"/></span><span t-if="company.country_id"> · <span t-field="company.country_id.name"/></span>
                        <br/>
                        <span t-if="company.phone"><span t-field="company.phone"/></span><span t-if="company.email"> · <span t-field="company.email"/></span>
                        <span t-if="company.vat">
                            · <t t-out="company.country_id.vat_label or 'Tax ID'"/>:
                            <span t-field="company.vat"/>
                        </span>
                        <span t-if="not is_html_empty(template.footer_note)"> · <span class="mobikey-footer-note" t-field="template.footer_note"/></span>
                    </div>
                    <div class="mobikey-footer-page">
                        <div t-if="document_status"
                             class="mobikey-footer-status"
                             t-attf-style="color: #{primary_color};">
                            <span t-out="document_status"/>
                        </div>
                        <span t-field="doc.name"/> · Page <span class="page"/> / <span class="topage"/>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="report_sale_document">
        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
        <t t-set="template" t-value="doc.mobikey_document_template_id"/>
        <t t-set="palette" t-value="template._get_mobikey_palette()"/>
        <t t-set="primary_color" t-value="palette['primary']"/>
        <t t-set="body_color" t-value="palette['body']"/>
        <t t-set="muted_color" t-value="palette['muted']"/>
        <t t-set="light_background" t-value="palette['light_background']"/>
        <t t-set="accent_stripe" t-value="palette['stripe']"/>
        <t t-set="primary_foreground" t-value="palette['primary_foreground']"/>
        <t t-set="light_foreground" t-value="palette['light_foreground']"/>
        <t t-set="is_proforma" t-value="doc.env.context.get('proforma', False)"/>
        <t t-set="document_status" t-value="doc._get_mobikey_watermark_text()"/>
        <t t-call="mobikey_sale_documents.report_sale_document_layout">
            <div class="page mobikey-report-page">
                <style>
                    .mobikey-section-title {
                        padding: 1.4mm 1.8mm;
                        margin: 5mm 0 2.5mm 0;
                        font-size: 10.75pt;
                        line-height: 1.2;
                        font-weight: bold;
                        text-transform: uppercase;
                        page-break-after: avoid !important;
                        break-after: avoid-page !important;
                    }
                    .mobikey-section-lead {
                        display: inline-block;
                        width: 100%;
                        box-sizing: border-box;
                        vertical-align: top;
                        page-break-inside: avoid !important;
                        break-inside: avoid-page !important;
                    }
                    .mobikey-label {
                        font-weight: bold;
                        white-space: nowrap;
                    }
                    .mobikey-table {
                        width: 100%;
                        border-collapse: collapse;
                    }
                    .mobikey-table th,
                    .mobikey-table td {
                        border: 0 !important;
                        padding: 1.1mm 1.4mm;
                        vertical-align: top;
                    }
                    .mobikey-table th {
                        font-weight: bold;
                    }
                    .mobikey-avoid-break {
                        page-break-inside: avoid;
                    }
                    .mobikey-muted {
                        color: inherit;
                    }
                    .mobikey-party-row,
                    .mobikey-spec-row,
                    .mobikey-observation,
                    .mobikey-payment-row,
                    .mobikey-bank-group,
                    .mobikey-bank-account-row,
                    .mobikey-signature-row {
                        width: 100%;
                        font-size: 0;
                        box-sizing: border-box;
                        border: 0 !important;
                        outline: 0 !important;
                        box-shadow: none !important;
                    }
                    .mobikey-party-column {
                        display: inline-block;
                        vertical-align: top;
                        box-sizing: border-box;
                        font-size: 10pt;
                    }
                    .mobikey-document-title,
                    .mobikey-document-status {
                        display: inline-block;
                        vertical-align: middle;
                    }
                    .mobikey-document-status {
                        margin-left: 3mm;
                        padding: 0.7mm 1.8mm;
                        border-radius: 1mm;
                        font-size: 10.5pt;
                        line-height: 1.1;
                        font-weight: bold;
                        letter-spacing: 0.35mm;
                        text-transform: uppercase;
                        white-space: nowrap;
                    }
                    .mobikey-issuer-summary {
                        margin-top: 2.5mm;
                        font-size: 9pt;
                        line-height: 1.25;
                    }
                    .mobikey-issuer-summary .mobikey-label {
                        display: block;
                        margin-bottom: 0.5mm;
                        text-transform: uppercase;
                    }
                    .mobikey-spec-grid {
                        width: 100%;
                        border: 0 !important;
                        outline: 0 !important;
                        box-shadow: none !important;
                    }
                    .mobikey-spec-row {
                        padding: 0.85mm 0;
                        line-height: 1.3;
                        page-break-inside: avoid !important;
                        break-inside: avoid-page !important;
                    }
                    .mobikey-spec-cell {
                        display: inline-block;
                        width: 50%;
                        box-sizing: border-box;
                        vertical-align: top;
                        font-size: 0;
                    }
                    .mobikey-spec-label,
                    .mobikey-spec-value {
                        display: inline-block;
                        box-sizing: border-box;
                        vertical-align: top;
                        font-size: 10pt;
                    }
                    .mobikey-spec-label {
                        width: 36%;
                        padding: 0 1.3mm;
                        text-align: right;
                        font-weight: bold;
                        white-space: nowrap;
                    }
                    .mobikey-spec-value {
                        width: 64%;
                        padding: 0 1.3mm;
                    }
                    .mobikey-spec-row,
                    .mobikey-spec-cell,
                    .mobikey-spec-label,
                    .mobikey-spec-value {
                        border: 0 !important;
                        outline: 0 !important;
                        box-shadow: none !important;
                    }
                    .mobikey-product-title {
                        margin: 2.5mm 0 1.8mm 0;
                        padding: 1.4mm 1.8mm;
                        font-size: 11.25pt;
                        line-height: 1.2;
                        font-weight: bold;
                        page-break-after: avoid !important;
                        break-after: avoid-page !important;
                    }
                    .mobikey-warranty {
                        margin-top: 2.2mm;
                        page-break-inside: avoid;
                        white-space: pre-line;
                        orphans: 3;
                        widows: 3;
                    }
                    .mobikey-observation {
                        width: 100%;
                        margin-top: 2mm;
                        padding: 1.5mm 0;
                        border: 0 !important;
                        outline: 0 !important;
                        box-shadow: none !important;
                        page-break-inside: avoid;
                    }
                    .mobikey-observation-label,
                    .mobikey-observation-value {
                        display: inline-block;
                        box-sizing: border-box;
                        padding: 0 1.8mm;
                        line-height: 1.35;
                        vertical-align: top;
                        font-size: 10pt;
                        border: 0 !important;
                    }
                    .mobikey-observation-label {
                        width: 18%;
                        text-align: right;
                        font-weight: bold;
                    }
                    .mobikey-observation-value {
                        width: 82%;
                        white-space: normal;
                        orphans: 3;
                        widows: 3;
                    }
                    .mobikey-commercial-table,
                    .mobikey-commercial-table thead,
                    .mobikey-commercial-table tbody,
                    .mobikey-commercial-table tr,
                    .mobikey-commercial-table th,
                    .mobikey-commercial-table td,
                    .mobikey-totals-table,
                    .mobikey-totals-table tbody,
                    .mobikey-totals-table tr,
                    .mobikey-totals-table th,
                    .mobikey-totals-table td {
                        border: 0 !important;
                        outline: 0 !important;
                        box-shadow: none !important;
                    }
                    .mobikey-commercial-table .mobikey-commercial-section td,
                    .mobikey-commercial-table .mobikey-commercial-note td {
                        background: #FFFFFF !important;
                    }
                    .mobikey-commercial-description {
                        text-align: left;
                        white-space: normal;
                        overflow-wrap: anywhere;
                    }
                    .mobikey-number {
                        text-align: right;
                        white-space: nowrap;
                    }
                    .mobikey-section-start {
                        page-break-inside: avoid;
                    }
                    .mobikey-payment-section {
                        display: inline-block;
                        width: 100%;
                        box-sizing: border-box;
                        margin-bottom: 3mm;
                        vertical-align: top;
                        page-break-inside: avoid !important;
                        break-inside: avoid-page !important;
                    }
                    .mobikey-payment-row {
                        padding: 1.35mm 1.8mm;
                        line-height: 1.3;
                        page-break-inside: avoid !important;
                        break-inside: avoid-page !important;
                    }
                    .mobikey-payment-label,
                    .mobikey-payment-value {
                        display: inline-block;
                        box-sizing: border-box;
                        vertical-align: top;
                        font-size: 10.5pt;
                        border: 0 !important;
                    }
                    .mobikey-payment-label {
                        width: 30%;
                        font-weight: bold;
                    }
                    .mobikey-payment-value {
                        width: 70%;
                    }
                    .mobikey-bank-section {
                        padding-top: 2mm;
                    }
                    .mobikey-bank-group {
                        padding: 1.8mm;
                        margin-bottom: 3mm;
                        page-break-inside: avoid !important;
                        break-inside: avoid-page !important;
                    }
                    .mobikey-bank-meta,
                    .mobikey-bank-accounts,
                    .mobikey-bank-name,
                    .mobikey-bank-detail,
                    .mobikey-bank-accounts-title,
                    .mobikey-bank-account-currency,
                    .mobikey-bank-account-number {
                        display: inline-block;
                        box-sizing: border-box;
                        vertical-align: top;
                        font-size: 10pt;
                        border: 0 !important;
                    }
                    .mobikey-bank-meta {
                        width: 42%;
                        padding-right: 4mm;
                    }
                    .mobikey-bank-accounts {
                        width: 58%;
                    }
                    .mobikey-bank-name {
                        display: block;
                        margin-bottom: 1mm;
                        font-size: 11pt;
                        font-weight: bold;
                    }
                    .mobikey-bank-detail {
                        display: block;
                        margin-bottom: 0.6mm;
                        line-height: 1.25;
                    }
                    .mobikey-bank-accounts-title {
                        display: block;
                        margin-bottom: 0.8mm;
                        font-size: 9.75pt;
                        font-weight: bold;
                        text-transform: uppercase;
                    }
                    .mobikey-bank-account-row {
                        padding: 0.7mm 0;
                        line-height: 1.25;
                    }
                    .mobikey-bank-account-currency {
                        width: 20%;
                        padding-right: 2mm;
                        font-weight: bold;
                    }
                    .mobikey-bank-account-number {
                        width: 80%;
                        font-size: 10.5pt;
                        white-space: nowrap;
                    }
                    .mobikey-totals-table td {
                        border: 0 !important;
                        padding: 0.7mm 1mm !important;
                    }
                    .mobikey-totals-table tr.o_total td,
                    .mobikey-totals-table tr.o_total strong {
                        color: inherit !important;
                        font-weight: bold !important;
                    }
                    .mobikey-totals-block {
                        width: 45%;
                        margin: 1.5mm 0 0 55%;
                        box-sizing: border-box;
                        page-break-inside: avoid !important;
                        break-inside: avoid-page !important;
                    }
                    .mobikey-commercial-item,
                    .mobikey-commercial-section,
                    .mobikey-commercial-note {
                        page-break-inside: avoid !important;
                        break-inside: avoid-page !important;
                    }
                    .mobikey-terms-title {
                        page-break-after: avoid !important;
                        break-after: avoid-page !important;
                    }
                    .mobikey-terms-content,
                    .mobikey-terms-content &gt; :first-child,
                    .mobikey-payment-note {
                        orphans: 3;
                        widows: 3;
                    }
                    .mobikey-terms-content &gt; :first-child {
                        page-break-before: avoid !important;
                        break-before: avoid-page !important;
                    }
                    .mobikey-signature-row {
                        margin-top: 5mm;
                        page-break-inside: avoid !important;
                        break-inside: avoid-page !important;
                    }
                    .mobikey-signature-column {
                        display: inline-block;
                        box-sizing: border-box;
                        padding: 0 3mm;
                        text-align: center;
                        vertical-align: bottom;
                        font-size: 10pt;
                        border: 0 !important;
                        outline: 0 !important;
                        box-shadow: none !important;
                    }
                    .mobikey-signature-line {
                        border-top: 1px solid #333333;
                        margin: 8px 0 3px 0;
                        padding-top: 3px;
                    }
                </style>

                <div class="mobikey-party-row" style="margin-top: 2mm;">
                    <div class="mobikey-party-column" style="width: 46%; padding-left: 0;">
                        <div style="margin-bottom: 1mm;">
                            <span class="mobikey-document-title"
                                  t-attf-style="font-size: 13pt; line-height: 1.2; font-weight: bold; text-transform: uppercase; color: #{primary_color};">
                                <t t-if="is_proforma">Proforma Invoice</t>
                                <t t-elif="doc.state in ('draft', 'sent')">Quotation</t>
                                <t t-else="">Sales Order</t>
                            </span>
                            <span t-if="document_status"
                                  class="mobikey-document-status"
                                  t-attf-style="border: 0.25mm solid #{primary_color}; color: #{primary_color}; background: #{light_background};">
                                <span t-out="document_status"/>
                            </span>
                        </div>
                        <div><span class="mobikey-label">Reference:</span> <span t-field="doc.name"/></div>
                        <div>
                            <span class="mobikey-label"><t t-if="is_proforma">Proforma Date</t><t t-else="">Quotation Date</t>:</span>
                            <span t-field="doc.date_order" t-options="{'widget': 'date'}"/>
                        </div>
                        <div t-if="doc.validity_date">
                            <span class="mobikey-label">Validity Date:</span>
                            <span t-field="doc.validity_date"/>
                        </div>
                        <div t-if="doc.client_order_ref">
                            <span class="mobikey-label">Customer Reference:</span>
                            <span t-field="doc.client_order_ref"/>
                        </div>
                        <div t-if="doc.user_id"><span class="mobikey-label">Salesperson:</span> <span t-field="doc.user_id"/></div>
                        <div t-if="doc.user_id.phone">
                            <span class="mobikey-label">Mobile:</span> <span t-field="doc.user_id.phone"/>
                        </div>
                        <div t-if="doc.user_id.email">
                            <span class="mobikey-label">Email:</span> <span t-field="doc.user_id.email"/>
                        </div>
                        <div class="mobikey-issuer-summary">
                            <span class="mobikey-label" t-attf-style="color: #{primary_color};">Issued By</span>
                            <div>
                                <strong t-field="doc.company_id.name"/>
                                <span t-if="doc.company_id.vat">
                                    · <t t-out="doc.company_id.country_id.vat_label or 'Tax ID'"/>:
                                    <span t-field="doc.company_id.vat"/>
                                </span>
                            </div>
                            <div t-if="doc.company_id.street or doc.company_id.street2 or doc.company_id.zip or doc.company_id.city or doc.company_id.country_id">
                                <span t-if="doc.company_id.street" t-field="doc.company_id.street"/><span t-if="doc.company_id.street2">, <span t-field="doc.company_id.street2"/></span><span t-if="doc.company_id.zip or doc.company_id.city"> · <span t-if="doc.company_id.zip" t-field="doc.company_id.zip"/> <span t-if="doc.company_id.city" t-field="doc.company_id.city"/></span><span t-if="doc.company_id.country_id"> · <span t-field="doc.company_id.country_id.name"/></span>
                            </div>
                            <div t-if="doc.company_id.phone or doc.company_id.email">
                                <span t-if="doc.company_id.phone" t-field="doc.company_id.phone"/><span t-if="doc.company_id.email"> · <span t-field="doc.company_id.email"/></span>
                            </div>
                        </div>
                    </div>
                    <div class="mobikey-party-column" style="width: 3%;"/>
                    <div class="mobikey-party-column"
                         t-attf-style="width: 51%; padding: 2mm; color: #{light_foreground}; background: #{light_background};">
                        <div class="mobikey-label">Customer</div>
                        <div t-field="doc.partner_id"
                             t-options='{"widget": "contact", "fields": ["name", "address", "phone", "email"], "no_marker": True}'/>
                        <div t-if="doc.partner_id.vat">
                            <span class="mobikey-label">
                                <t t-out="doc.company_id.account_fiscal_country_id.vat_label or 'Tax ID'"/>:
                            </span>
                            <span t-field="doc.partner_id.vat"/>
                        </div>
                    </div>
                </div>

                <t t-set="characteristic_lines" t-value="doc._get_mobikey_characteristic_product_lines()"/>
                <t t-foreach="characteristic_lines" t-as="characteristic_line">
                    <div style="margin-bottom: 4mm;">
                        <t t-set="product_section_title"
                           t-value="'1. Description and Product Characteristics' if characteristic_line_first else False"/>
                        <t t-call="mobikey_sale_documents.report_product_characteristics"/>
                    </div>
                </t>

                <t t-set="commercial_lines" t-value="doc._get_order_lines_to_report()"/>
                <t t-set="display_discount" t-value="any(line.discount &gt; 0 for line in commercial_lines if not line.display_type)"/>
                <t t-set="display_taxes" t-value="any(line._has_taxes() for line in commercial_lines if not line.display_type)"/>
                <t t-call="mobikey_sale_documents.report_section_lead">
                    <div class="mobikey-section-title"
                         t-attf-style="background: #{primary_color}; color: #{primary_foreground};">
                        2. Commercial Conditions
                    </div>
                    <table class="mobikey-table mobikey-commercial-table">
                        <t t-call="mobikey_sale_documents.report_commercial_columns"/>
                        <thead t-attf-style="background: #{light_background}; color: #{light_foreground};">
                            <tr>
                                <th style="text-align: left;">Description</th>
                                <th class="mobikey-number">Quantity</th>
                                <th class="mobikey-number">Unit Price</th>
                                <th t-if="display_discount" class="mobikey-number">Disc.%</th>
                                <th t-if="display_taxes" class="mobikey-number">Taxes</th>
                                <th class="mobikey-number">Amount</th>
                            </tr>
                        </thead>
                        <tbody t-if="commercial_lines">
                            <t t-set="line" t-value="commercial_lines[0]"/>
                            <t t-set="commercial_line_index" t-value="0"/>
                            <t t-call="mobikey_sale_documents.report_commercial_line"/>
                        </tbody>
                    </table>
                </t>
                <table t-if="commercial_lines[1:]"
                       class="mobikey-table mobikey-commercial-table mobikey-commercial-continuation">
                    <t t-call="mobikey_sale_documents.report_commercial_columns"/>
                    <tbody>
                        <t t-foreach="commercial_lines[1:]" t-as="line">
                            <t t-set="commercial_line_index"
                               t-value="sum(1 for previous_line in commercial_lines[:line_index + 1] if not previous_line.display_type)"/>
                            <t t-call="mobikey_sale_documents.report_commercial_line"/>
                        </t>
                    </tbody>
                </table>

                <div class="mobikey-totals-block">
                    <table class="table table-borderless mobikey-totals-table"
                           t-attf-style="width: 100%; font-size: 10pt; color: #{primary_color}; font-weight: bold;">
                        <tr t-if="doc.mobikey_discount_total">
                            <td>Aggregate Line Discount</td>
                            <td style="text-align: right;">
                                <span t-field="doc.mobikey_discount_total"/>
                            </td>
                        </tr>
                        <t t-call="sale.document_tax_totals">
                            <t t-set="tax_totals" t-value="doc.tax_totals"/>
                            <t t-set="currency" t-value="doc.currency_id"/>
                        </t>
                    </table>
                </div>

                <t t-set="payment_rows" t-value="([('payment', 'Payment Conditions')] if doc.payment_term_id else []) + ([('delivery_terms', 'Delivery Terms')] if doc.mobikey_delivery_terms else []) + ([('delivery_date', 'Expected Delivery Date')] if doc.commitment_date else []) + ([('validity', 'Proforma Validity' if is_proforma else 'Quotation Validity')] if doc.validity_date else [])"/>
                <div t-if="payment_rows" class="mobikey-payment-section">
                    <t t-call="mobikey_sale_documents.report_section_lead">
                        <div class="mobikey-section-title"
                             t-attf-style="background: #{primary_color}; color: #{primary_foreground};">
                            3. Payment, Delivery and Validity
                        </div>
                        <t t-set="payment_row" t-value="payment_rows[0]"/>
                        <t t-set="payment_row_index" t-value="0"/>
                        <t t-call="mobikey_sale_documents.report_payment_row"/>
                    </t>
                    <t t-foreach="payment_rows[1:]" t-as="payment_row">
                        <t t-set="payment_row_index" t-value="payment_row_index + 1"/>
                        <t t-call="mobikey_sale_documents.report_payment_row"/>
                    </t>
                </div>
                <div t-if="doc.payment_term_id and not is_html_empty(doc.payment_term_id.note)"
                     class="mobikey-payment-note"
                     style="margin-top: 1.5mm;">
                    <span t-field="doc.payment_term_id.note"/>
                </div>

                <t t-set="bank_groups" t-value="doc._get_mobikey_bank_groups()"/>
                <div t-if="bank_groups" class="mobikey-bank-section">
                    <t t-call="mobikey_sale_documents.report_section_lead">
                        <div class="mobikey-section-title"
                             t-attf-style="background: #{primary_color}; color: #{primary_foreground};">
                            4. Bank References
                        </div>
                        <t t-set="bank_group" t-value="bank_groups[0]"/>
                        <t t-call="mobikey_sale_documents.report_bank_group"/>
                    </t>
                    <t t-foreach="bank_groups[1:]" t-as="bank_group">
                        <t t-call="mobikey_sale_documents.report_bank_group"/>
                    </t>
                </div>

                <div t-if="not is_html_empty(doc.note)"
                     class="mobikey-section-title mobikey-terms-title"
                     t-attf-style="background: #{primary_color}; color: #{primary_foreground};">
                    5. Terms and Conditions
                </div>
                <span t-if="not is_html_empty(doc.note)"
                      t-field="doc.note"
                      class="mobikey-terms-content"
                      t-attf-style="#{'text-align:justify;text-justify:inter-word;' if doc.company_id.terms_type != 'html' else ''}"
                      name="order_note"/>

                <t t-set="signature_count"
                   t-value="1 + (1 if template.signatory_2_id or template.signatory_2_image else 0) + (1 if template.show_customer_signature else 0)"/>
                <t t-call="mobikey_sale_documents.report_section_lead">
                    <div class="mobikey-section-title"
                         t-attf-style="background: #{primary_color}; color: #{primary_foreground};">
                        6. Signatures
                    </div>
                    <div class="mobikey-signature-row">
                        <div class="mobikey-signature-column" t-attf-style="width: #{100.0 / signature_count}%;">
                            <img t-if="template.signatory_1_image"
                                 t-att-src="image_data_uri(template.signatory_1_image)"
                                 alt="First signature"
                                 style="max-width: 150px; max-height: 55px; object-fit: contain;"/>
                            <div t-else="" style="height: 55px;"/>
                            <div class="mobikey-signature-line">
                                <strong t-if="template.signatory_1_id" t-field="template.signatory_1_id.name"/>
                                <strong t-else="" t-field="doc.user_id.name"/>
                            </div>
                            <div t-if="template.signatory_1_title" t-field="template.signatory_1_title"/>
                            <div t-else="" t-field="doc.company_id.name"/>
                        </div>
                        <div t-if="template.signatory_2_id or template.signatory_2_image"
                             class="mobikey-signature-column"
                             t-attf-style="width: #{100.0 / signature_count}%;">
                            <img t-if="template.signatory_2_image"
                                 t-att-src="image_data_uri(template.signatory_2_image)"
                                 alt="Second signature"
                                 style="max-width: 150px; max-height: 55px; object-fit: contain;"/>
                            <div t-else="" style="height: 55px;"/>
                            <div class="mobikey-signature-line">
                                <strong t-if="template.signatory_2_id" t-field="template.signatory_2_id.name"/>
                            </div>
                            <div t-if="template.signatory_2_title" t-field="template.signatory_2_title"/>
                        </div>
                        <div t-if="template.show_customer_signature"
                             class="mobikey-signature-column"
                             t-attf-style="width: #{100.0 / signature_count}%;">
                            <img t-if="doc.signature and doc.env.context.get('sale_include_signature')"
                                 t-att-src="image_data_uri(doc.signature)"
                                 alt="Customer signature"
                                 style="max-width: 150px; max-height: 55px; object-fit: contain;"/>
                            <div t-else="" style="height: 55px;"/>
                            <div class="mobikey-signature-line">
                                <strong t-if="doc.signed_by and doc.env.context.get('sale_include_signature')"
                                        t-field="doc.signed_by"/>
                                <strong t-else="" t-field="doc.partner_id.name"/>
                            </div>
                            <div>Customer</div>
                        </div>
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>
