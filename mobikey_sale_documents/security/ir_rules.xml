<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_mobikey_document_template_company" model="ir.rule">
        <field name="name">Proforma templates for allowed companies</field>
        <field name="model_id" ref="model_mobikey_document_template"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_mobikey_product_specification_company" model="ir.rule">
        <field name="name">Quotation specifications for allowed companies</field>
        <field name="model_id" ref="model_mobikey_product_specification"/>
        <field name="domain_force">['|', ('product_tmpl_id.company_id', '=', False), ('product_tmpl_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
