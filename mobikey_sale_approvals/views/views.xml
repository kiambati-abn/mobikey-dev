<odoo>
  <record id="order_form" model="ir.ui.view">
    <field name="name">sale.order.mobikey.approvals</field><field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_submit_approvals" type="object" string="Submit for approval" class="btn-primary" invisible="state not in ['draft', 'sent'] or approval_submitted or approval_status == 'ready'"/>
        <button name="action_revise_quotation" type="object" string="Revise quotation" invisible="state not in ['draft', 'sent'] or not approval_submitted"/>
        <button name="action_import_legacy_products" type="object" string="Import historical CRM products" invisible="state != 'draft' or not opportunity_id or order_line or approval_submitted"/>
      </xpath>
      <xpath expr="//notebook" position="before">
        <group string="Commercial review"><field name="approval_revision"/><field name="approval_status" widget="badge"/><field name="approval_submitted" invisible="1"/></group>
      </xpath>
      <xpath expr="//notebook" position="inside">
        <page string="Approvals" name="mobikey_approvals"><field name="approval_ids" readonly="1"><list create="0" delete="0"><field name="revision"/><field name="category"/><field name="status"/><field name="assigned_user_ids" widget="many2many_tags"/><field name="requested_at"/><field name="deadline"/><field name="decided_by"/><field name="decided_at"/></list></field></page>
        <page string="Delivery and financing" name="mobikey_commercial"><group><group><field name="bank_id"/><field name="trade_in"/><field name="trade_in_valuation" invisible="not trade_in"/></group><group><field name="insurance_required"/><field name="after_sales_user_id"/><field name="first_issued_at"/></group></group></page>
      </xpath>
      <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after"><field name="vehicle_year" optional="hide"/><field name="vehicle_mileage" optional="hide"/><field name="reconditioning_cost" optional="hide" groups="mobikey_sale_approvals.group_financial_visibility"/><field name="target_margin_snapshot" optional="hide" groups="mobikey_sale_approvals.group_financial_visibility"/></xpath>
    </field>
  </record>
  <record id="lead_form" model="ir.ui.view"><field name="name">crm.lead.primary.quotation</field><field name="model">crm.lead</field><field name="inherit_id" ref="crm.crm_lead_view_form"/><field name="arch" type="xml">
    <xpath expr="//field[@name='expected_revenue']" position="attributes"><attribute name="readonly">primary_quotation_id</attribute></xpath>
    <xpath expr="//notebook" position="before"><group string="Forecast source"><field name="primary_quotation_id"/><field name="quotation_revenue_updated_at"/><field name="operating_country_id"/><field name="qualification_readiness" invisible="type != 'lead'"/></group></xpath>
    <xpath expr="//notebook" position="inside"><page string="Historical CRM approvals" groups="base.group_system"><group><field name="discount_approval_status" readonly="1"/><field name="discount_approved_by"/><field name="discount_approval_date"/><field name="margin_approval_status" readonly="1"/><field name="margin_approved_by"/><field name="margin_approval_date"/><field name="financing_approval_status" readonly="1"/><field name="financing_approved_by"/><field name="financing_approval_date"/><field name="trade_in_approval_status" readonly="1"/><field name="trade_in_approved_by"/><field name="trade_in_approval_date"/><field name="commission_approval_status" readonly="1"/><field name="commission_approved_by"/><field name="commission_approval_date"/></group></page></xpath>
  </field></record>
  <record id="approval_form" model="ir.ui.view"><field name="name">mobikey.approval.form</field><field name="model">mobikey.sale.approval</field><field name="arch" type="xml"><form create="0" delete="0"><header><button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="status != 'pending'"/><button name="action_request_changes" type="object" string="Request changes" invisible="status != 'pending'"/><field name="status" widget="statusbar"/></header><sheet><group><field name="order_id" readonly="1"/><field name="revision" readonly="1"/><field name="category" readonly="1"/><field name="assigned_user_ids" widget="many2many_tags"/><field name="requested_by" readonly="1"/><field name="requested_at" readonly="1"/><field name="deadline" readonly="1"/><field name="decided_by" readonly="1"/><field name="decided_at" readonly="1"/><field name="turnaround_hours"/><field name="change_request" readonly="status != 'pending'"/></group></sheet><chatter/></form></field></record>
  <record id="approval_list" model="ir.ui.view"><field name="name">mobikey.approval.list</field><field name="model">mobikey.sale.approval</field><field name="arch" type="xml"><list create="0" delete="0"><field name="order_id"/><field name="revision"/><field name="category"/><field name="status"/><field name="assigned_user_ids" widget="many2many_tags"/><field name="deadline"/><field name="turnaround_hours"/></list></field></record>
  <record id="approval_action" model="ir.actions.act_window"><field name="name">Quotation approvals</field><field name="res_model">mobikey.sale.approval</field><field name="view_mode">list,form,pivot,graph</field><field name="domain">[('assigned_user_ids', 'in', uid), ('status', '=', 'pending')]</field></record>
  <menuitem id="approval_menu" name="My approvals" parent="sale.sale_order_menu" action="approval_action" groups="group_approver"/>
  <record id="approval_analysis" model="ir.actions.act_window"><field name="name">Approval turnaround</field><field name="res_model">mobikey.sale.approval</field><field name="view_mode">pivot,graph,list,form</field><field name="context">{'group_by': ['category', 'status']}</field></record>
  <menuitem id="approval_analysis_menu" name="Approval turnaround" parent="sale.menu_sale_report" action="approval_analysis" groups="sales_team.group_sale_salesman_all_leads"/>
  <record id="snapshot_action" model="ir.actions.act_window"><field name="name">Forecast history</field><field name="res_model">mobikey.forecast.snapshot</field><field name="view_mode">pivot,graph,list</field><field name="context">{'group_by': ['snapshot_date', 'user_id']}</field></record>
  <menuitem id="snapshot_menu" name="Forecast history" parent="sale.menu_sale_report" action="snapshot_action"/>
  <record id="company_form" model="ir.ui.view"><field name="name">res.company.mobikey.approvals</field><field name="model">res.company</field><field name="inherit_id" ref="base.view_company_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Sales approvals" groups="base.group_system"><group><group><field name="mobikey_revenue_basis"/><field name="mobikey_approval_checkpoint"/><field name="mobikey_trade_in_threshold"/><field name="mobikey_trade_in_configured"/><field name="mobikey_trade_in_authority"/><field name="mobikey_commission_milestone"/><field name="mobikey_approval_days"/></group><group><field name="mobikey_sm_ids" widget="many2many_tags"/><field name="mobikey_gm_ids" widget="many2many_tags"/><field name="mobikey_hq_ids" widget="many2many_tags"/><field name="mobikey_finance_ids" widget="many2many_tags"/></group></group></page></xpath></field></record>
</odoo>
