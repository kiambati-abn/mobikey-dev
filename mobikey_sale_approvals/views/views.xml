<odoo>
  <record id="order_form" model="ir.ui.view">
    <field name="name">sale.order.mobikey.approvals</field><field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_submit_approvals" type="object" string="Submit for approval" class="btn-primary" invisible="state not in ['draft', 'sent'] or approval_submitted or approval_status == 'ready'"/>
        <button name="action_revise_quotation" type="object" string="Revise quotation" invisible="state not in ['draft', 'sent'] or not approval_submitted"/>
        <button name="action_view_mobikey_approvals" type="object" string="Approvals"
                invisible="approval_count == 0"/>
        <button name="action_approve_current" type="object" string="Approve"
                class="btn-primary" invisible="my_actionable_approval_count != 1"/>
        <button name="action_request_changes_current" type="object" string="Request changes"
                invisible="my_actionable_approval_count != 1"/>
        <button name="action_review_my_approvals" type="object" string="Review my approvals"
                class="btn-primary" invisible="my_actionable_approval_count &lt;= 1"/>
        <field name="my_actionable_approval_count" invisible="1"/>
      </xpath>
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_view_mobikey_approvals" type="object" class="oe_stat_button"
                icon="fa-check-square-o" invisible="approval_count == 0">
          <field name="approval_count" widget="statinfo" string="Approvals"/>
        </button>
      </xpath>
      <xpath expr="//notebook" position="before">
        <group string="Commercial review">
          <group>
            <field name="approval_revision"/>
            <field name="approval_status" widget="badge" decoration-muted="approval_status == 'draft'" decoration-success="approval_status == 'ready'" decoration-warning="approval_status == 'pending'" decoration-danger="approval_status == 'rejected'"/>
            <field name="approval_progress" readonly="1" invisible="approval_count == 0"/>
          </group>
          <group invisible="approval_count == 0">
            <field name="approval_approved_user_ids" widget="many2many_tags" readonly="1"/>
            <field name="approval_current_user_ids" widget="many2many_tags" readonly="1"/>
            <field name="approval_next_user_ids" widget="many2many_tags" readonly="1"/>
          </group>
          <field name="approval_submitted" invisible="1"/>
          <field name="approval_policy_snapshot" invisible="1"/>
        </group>
      </xpath>
      <xpath expr="//notebook" position="inside">
        <page string="Approvals" name="mobikey_approvals"><field name="approval_ids" readonly="1"><list create="0" delete="0"><field name="revision"/><field name="sequence"/><field name="category"/><field name="authority_label"/><field name="workflow_state" widget="badge" decoration-info="workflow_state == 'queued'" decoration-warning="workflow_state == 'active'" decoration-success="workflow_state == 'approved'" decoration-danger="workflow_state == 'rejected'" decoration-muted="workflow_state == 'withdrawn'"/><field name="assigned_user_ids" widget="many2many_tags"/><field name="requested_at"/><field name="deadline"/><field name="decided_by"/><field name="decided_at"/></list></field></page>
        <page string="Delivery and financing" name="mobikey_commercial"><group><group><field name="bank_id"/><field name="financing_required"/><field name="financing_approval_required" invisible="1"/><field name="trade_in"/><field name="trade_in_valuation" invisible="not trade_in"/></group><group><field name="insurance_required"/><field name="after_sales_user_id"/><field name="first_issued_at"/></group></group></page>
      </xpath>
      <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after"><field name="vehicle_year" optional="hide"/><field name="vehicle_mileage" optional="hide"/><field name="reconditioning_cost" optional="hide" groups="mobikey_sale_approvals.group_financial_visibility"/></xpath>
    </field>
  </record>
  <record id="lead_form" model="ir.ui.view"><field name="name">crm.lead.primary.quotation</field><field name="model">crm.lead</field><field name="inherit_id" ref="crm.crm_lead_view_form"/><field name="arch" type="xml">
    <xpath expr="//field[@name='expected_revenue']" position="attributes"><attribute name="readonly">revenue_quotation_count &gt; 0</attribute></xpath>
    <xpath expr="//notebook" position="before"><group string="Forecast source"><field name="revenue_quotation_count" readonly="1"/><field name="quotation_revenue_updated_at"/><field name="operating_country_id"/><field name="qualification_readiness" invisible="type != 'lead'"/></group></xpath>
  </field></record>
  <record id="approval_form" model="ir.ui.view">
    <field name="name">mobikey.approval.form</field>
    <field name="model">mobikey.sale.approval</field>
    <field name="arch" type="xml">
      <form create="0" delete="0">
        <header>
          <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="not can_decide"/>
          <button name="action_request_changes" type="object" string="Request changes" invisible="not can_decide"/>
          <field name="can_decide" invisible="1"/>
          <field name="status" widget="statusbar"/>
        </header>
        <sheet>
          <group>
            <field name="order_id" readonly="1"/>
            <field name="revision" readonly="1"/>
            <field name="sequence" readonly="1"/>
            <field name="category" readonly="1"/>
            <field name="authority_label" readonly="1"/>
            <field name="workflow_state" widget="badge" readonly="1"/>
            <field name="assigned_user_ids" widget="many2many_tags" readonly="1"/>
            <field name="requested_by" readonly="1"/>
            <field name="requested_at" readonly="1"/>
            <field name="deadline" readonly="1"/>
            <field name="decided_by" readonly="1"/>
            <field name="decided_at" readonly="1"/>
            <field name="turnaround_hours"/>
          </group>
          <group string="Submitted decision information">
            <field name="preview_summary" nolabel="1" colspan="2" readonly="1"/>
            <field name="margin_preview" nolabel="1" colspan="2" readonly="1"
                   invisible="category not in ['margin', 'margin_hq']"
                   groups="mobikey_sale_approvals.group_financial_visibility"/>
          </group>
          <group string="Reason for requested changes" invisible="not change_request">
            <field name="change_request" nolabel="1" colspan="2" readonly="1"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="approval_request_changes_form" model="ir.ui.view">
    <field name="name">mobikey.approval.request.changes.form</field>
    <field name="model">mobikey.sale.approval.request.changes</field>
    <field name="arch" type="xml">
      <form string="Request changes">
        <group>
          <field name="approval_id"/>
          <field name="reason" placeholder="Explain what needs to change in customer-safe language. Do not include internal costs or margins."/>
        </group>
        <footer>
          <button name="action_confirm" type="object" string="Request changes" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
  <record id="approval_list" model="ir.ui.view"><field name="name">mobikey.approval.list</field><field name="model">mobikey.sale.approval</field><field name="arch" type="xml"><list create="0" delete="0"><field name="order_id"/><field name="revision"/><field name="sequence"/><field name="category"/><field name="authority_label"/><field name="workflow_state" widget="badge" decoration-info="workflow_state == 'queued'" decoration-warning="workflow_state == 'active'" decoration-success="workflow_state == 'approved'" decoration-danger="workflow_state == 'rejected'" decoration-muted="workflow_state == 'withdrawn'"/><field name="assigned_user_ids" widget="many2many_tags"/><field name="deadline"/><field name="turnaround_hours"/></list></field></record>
  <record id="approval_action" model="ir.actions.act_window"><field name="name">Quotation approvals</field><field name="res_model">mobikey.sale.approval</field><field name="view_mode">list,form,pivot,graph</field><field name="domain">[('assigned_user_ids', 'in', uid), ('status', '=', 'pending')]</field></record>
  <menuitem id="approval_menu" name="My approvals" parent="sale.sale_order_menu" action="approval_action" groups="group_approver"/>
  <record id="approval_analysis" model="ir.actions.act_window"><field name="name">Approval turnaround</field><field name="res_model">mobikey.sale.approval</field><field name="view_mode">pivot,graph,list,form</field><field name="context">{'group_by': ['category', 'status']}</field></record>
  <menuitem id="approval_analysis_menu" name="Approval turnaround" parent="sale.menu_sale_report" action="approval_analysis" groups="sales_team.group_sale_salesman_all_leads"/>
  <record id="snapshot_action" model="ir.actions.act_window"><field name="name">Forecast history</field><field name="res_model">mobikey.forecast.snapshot</field><field name="view_mode">pivot,graph,list</field><field name="context">{'group_by': ['snapshot_date', 'user_id']}</field></record>
  <menuitem id="snapshot_menu" name="Forecast history" parent="sale.menu_sale_report" action="snapshot_action"/>
  <record id="company_form" model="ir.ui.view"><field name="name">res.company.mobikey.approvals</field><field name="model">res.company</field><field name="inherit_id" ref="base.view_company_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Sales approvals" groups="base.group_system"><group><group string="Approval policy"><field name="mobikey_sm_discount_limit"/><field name="mobikey_gm_discount_limit"/><field name="mobikey_minimum_margin"/><field name="mobikey_revenue_basis"/><field name="mobikey_approval_checkpoint"/><field name="mobikey_approval_days"/></group><group string="Assigned approvers"><field name="mobikey_sm_ids" widget="many2many_tags"/><field name="mobikey_gm_ids" widget="many2many_tags"/><field name="mobikey_hq_ids" widget="many2many_tags"/><field name="mobikey_finance_ids" widget="many2many_tags"/></group><group string="Trade-in and commission"><field name="mobikey_trade_in_approver_ids" widget="many2many_tags" domain="[('share', '=', False), ('company_ids', 'in', [id])]" options="{'no_create': True, 'no_create_edit': True}"/><field name="mobikey_commission_milestone"/></group></group></page></xpath></field></record>
  <record id="product_margin_form" model="ir.ui.view">
    <field name="name">product.template.mobikey.minimum.margin</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='standard_price']" position="after">
        <field name="mobikey_minimum_margin"
               groups="mobikey_sale_approvals.group_financial_visibility"/>
      </xpath>
    </field>
  </record>
</odoo>
