<odoo>
  <record id="group_financial_visibility" model="res.groups"><field name="name">Financial cost and margin visibility</field></record>
  <record id="group_approver" model="res.groups"><field name="name">Quotation approver</field><field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/></record>
  <record id="mobikey_crm.group_mobikey_sales_manager" model="res.groups"><field name="implied_ids" eval="[(4, ref('group_approver'))]"/></record>
  <record id="mobikey_crm.group_mobikey_country_director" model="res.groups"><field name="name">Legacy Country Director (review membership)</field></record>
  <record id="mobikey_crm.group_mobikey_country_gm" model="res.groups"><field name="implied_ids" eval="[(4, ref('group_financial_visibility')), (4, ref('mobikey_crm.group_mobikey_sales_manager'))]"/></record>
  <record id="mobikey_crm.group_mobikey_hq" model="res.groups"><field name="implied_ids" eval="[(3, ref('mobikey_crm.group_mobikey_country_director')), (4, ref('mobikey_crm.group_mobikey_country_gm'))]"/></record>
  <record id="mobikey_crm.group_mobikey_finance" model="res.groups"><field name="implied_ids" eval="[(4, ref('group_approver')), (4, ref('group_financial_visibility'))]"/></record>
  <record id="base.group_system" model="res.groups"><field name="implied_ids" eval="[(4, ref('group_financial_visibility'))]"/></record>
  <record id="approval_company" model="ir.rule"><field name="name">Approval companies</field><field name="model_id" ref="model_mobikey_sale_approval"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
  <record id="approval_own" model="ir.rule"><field name="name">Own or assigned approvals</field><field name="model_id" ref="model_mobikey_sale_approval"/><field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/><field name="domain_force">['|', ('order_id.user_id', '=', user.id), ('assigned_user_ids', 'in', user.id)]</field></record>
  <record id="approval_all_sales" model="ir.rule"><field name="name">All sales approval summaries</field><field name="model_id" ref="model_mobikey_sale_approval"/><field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/><field name="domain_force">[(1, '=', 1)]</field></record>
  <record id="assigned_orders" model="ir.rule"><field name="name">Quotations assigned for review</field><field name="model_id" ref="sale.model_sale_order"/><field name="groups" eval="[(4, ref('group_approver'))]"/><field name="domain_force">[('approval_ids.assigned_user_ids', 'in', user.id)]</field></record>
  <record id="assigned_lines" model="ir.rule"><field name="name">Lines assigned for review</field><field name="model_id" ref="sale.model_sale_order_line"/><field name="groups" eval="[(4, ref('group_approver'))]"/><field name="domain_force">[('order_id.approval_ids.assigned_user_ids', 'in', user.id)]</field></record>
  <record id="snapshot_company" model="ir.rule"><field name="name">Forecast companies</field><field name="model_id" ref="model_mobikey_forecast_snapshot"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
  <record id="snapshot_own" model="ir.rule"><field name="name">Own historical forecasts</field><field name="model_id" ref="model_mobikey_forecast_snapshot"/><field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/><field name="domain_force">[('user_id', '=', user.id)]</field></record>
  <record id="snapshot_all" model="ir.rule"><field name="name">Team historical forecasts</field><field name="model_id" ref="model_mobikey_forecast_snapshot"/><field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/><field name="domain_force">[(1, '=', 1)]</field></record>
</odoo>
