<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record model="ir.module.category" id="module_crm_approval">
            <field name="name">Quotation Approval</field>
            <field name="sequence">45</field>
        </record>
        <record model="res.groups.privilege" id="res_groups_crm_approval_privilege">
            <field name="name">Commercial Approval</field>
            <field name="category_id" ref="module_crm_approval"/>
        </record>
        <record model="res.groups.privilege" id="res_groups_finance_approval_privilege">
            <field name="name">Finance Approval</field>
            <field name="category_id" ref="module_crm_approval"/>
        </record>
        <!-- Sales Manager — approves discounts up to the configured company limit -->
        <record id="group_mobikey_sales_manager" model="res.groups">
            <field name="name">Sales Manager (Quotation Approvals)</field>
            <field name="privilege_id" ref="res_groups_crm_approval_privilege"/>
        </record>

        <!-- Country GM — approves configured discount band, margin review and commission -->
        <record id="group_mobikey_country_gm" model="res.groups">
            <field name="name">Country GM (Quotation Approvals)</field>
            <field name="privilege_id" ref="res_groups_crm_approval_privilege"/>

            <!-- GM should be above Sales Manager -->
            <field name="implied_ids" eval="[(4, ref('mobikey_crm.group_mobikey_sales_manager'))]"/>
        </record>

        <!-- HQ — approves discounts above the configured Country GM limit -->
        <record id="group_mobikey_hq" model="res.groups">
            <field name="name">HQ (Quotation Approvals)</field>
            <field name="privilege_id" ref="res_groups_crm_approval_privilege"/>
            <field name="implied_ids" eval="[(4, ref('mobikey_crm.group_mobikey_country_gm'))]"/>
        </record>

        <!-- Finance — approves financing requests and trade-in deals -->
        <record id="group_mobikey_finance" model="res.groups">
            <field name="name">Finance (Quotation Approvals)</field>
            <field name="privilege_id" ref="res_groups_finance_approval_privilege"/>
        </record>

    </data>
</odoo>
