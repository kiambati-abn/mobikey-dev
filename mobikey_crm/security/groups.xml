<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record model="ir.module.category" id="module_crm_approval">
            <field name="name">Quotation Approval</field>
            <field name="sequence">45</field>
        </record>
        <record model="res.groups.privilege" id="res_groups_crm_approval_privilege">
            <field name="name">Commercial Approval</field>
            <field name="category_id" ref="module_crm_approval"/>
        </record>
        <record model="res.groups.privilege" id="res_groups_finance_approval_privilege">
            <field name="name">Finance Approval</field>
            <field name="category_id" ref="module_crm_approval"/>
        </record>
        <!-- Keep legacy memberships for historical approvals and existing access.
             No user-form selectors and no new approval routing through these roles. -->
        <record id="group_mobikey_sales_manager" model="res.groups">
            <field name="name">Sales Manager (Legacy Access)</field>
            <field name="privilege_id" eval="False"/>
        </record>

        <!-- Country GM legacy access -->
        <record id="group_mobikey_country_gm" model="res.groups">
            <field name="name">Country GM (Legacy Access)</field>
            <field name="privilege_id" eval="False"/>

            <!-- GM should be above Sales Manager -->
            <field name="implied_ids" eval="[(4, ref('mobikey_crm.group_mobikey_sales_manager'))]"/>
        </record>

        <!-- HQ legacy access -->
        <record id="group_mobikey_hq" model="res.groups">
            <field name="name">HQ (Legacy Access)</field>
            <field name="privilege_id" eval="False"/>
            <field name="implied_ids" eval="[(4, ref('mobikey_crm.group_mobikey_country_gm'))]"/>
        </record>

        <!-- Finance legacy access -->
        <record id="group_mobikey_finance" model="res.groups">
            <field name="name">Finance (Legacy Access)</field>
            <field name="privilege_id" eval="False"/>
        </record>

        <!-- Read-wide CRM visibility for country GMs and similar roles without
             Sales Administrator configuration rights. The matching access policy
             (data/access_policy_and_deal_types.xml) defines the record scopes. -->
        <record model="res.groups.privilege" id="res_groups_crm_visibility_privilege">
            <field name="name">CRM Visibility</field>
            <field name="sequence">2</field>
            <field name="category_id" ref="base.module_category_sales"/>
            <field name="description">View every lead and opportunity in the user's allowed companies without Sales Administrator rights.</field>
        </record>
        <record id="group_crm_view_all" model="res.groups">
            <field name="name">View All Opportunities</field>
            <field name="privilege_id" ref="res_groups_crm_visibility_privilege"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="comment">Sees all leads and opportunities in the allowed companies. Edits, creation and reassignment stay limited to assigned records and teams led; no deletion.</field>
        </record>

    </data>
</odoo>
