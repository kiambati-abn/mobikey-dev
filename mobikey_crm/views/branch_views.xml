<odoo>
  <record id="branch_company_rule" model="ir.rule">
    <field name="name">Branches in allowed companies</field>
    <field name="model_id" ref="model_mobikey_branch"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="branch_list" model="ir.ui.view">
    <field name="name">mobikey.branch.list</field><field name="model">mobikey.branch</field>
    <field name="arch" type="xml"><list><field name="name"/><field name="company_id" groups="base.group_multi_company"/><field name="active" optional="hide"/></list></field>
  </record>
  <record id="branch_form" model="ir.ui.view">
    <field name="name">mobikey.branch.form</field><field name="model">mobikey.branch</field>
    <field name="arch" type="xml"><form><sheet><widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/><group><field name="name"/><field name="company_id" groups="base.group_multi_company"/><field name="active" invisible="1"/></group></sheet></form></field>
  </record>
  <record id="branch_search" model="ir.ui.view">
    <field name="name">mobikey.branch.search</field><field name="model">mobikey.branch</field>
    <field name="arch" type="xml"><search><field name="name"/><field name="company_id" groups="base.group_multi_company"/><filter name="archived" string="Archived" domain="[('active', '=', False)]"/></search></field>
  </record>
  <record id="branch_action" model="ir.actions.act_window">
    <field name="name">Branches</field><field name="res_model">mobikey.branch</field><field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_branch" name="Branches" parent="crm.crm_menu_config" action="branch_action" groups="sales_team.group_sale_manager,base.group_system" sequence="57"/>
</odoo>
