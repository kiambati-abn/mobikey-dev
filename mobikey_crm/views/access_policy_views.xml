<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_access_policy_list" model="ir.ui.view">
        <field name="name">mobikey.crm.access.policy.list</field>
        <field name="model">mobikey.crm.access.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="group_id" />
                <field name="read_scope" />
                <field name="write_scope" />
                <field name="create_scope" />
                <field name="unlink_scope" />
                <field name="reassign_scope" />
                <field name="active" />
            </list>
        </field>
    </record>
    <record id="crm_access_policy_form" model="ir.ui.view">
        <field name="name">mobikey.crm.access.policy.form</field>
        <field name="model">mobikey.crm.access.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-info" role="alert">Active policies grant access together. No grant does not revoke another policy's grant. Company restrictions and model permissions always apply. Administrators retain recovery access. Team scopes include assigned records; leadership and membership come from Sales Teams.</div>
                    <group>
                        <field name="name" />
                        <field name="group_id" options="{'no_create': True}" />
                        <field name="active" />
                    </group>
                    <group>
                        <field name="read_scope" />
                        <field name="write_scope" />
                        <field name="create_scope" />
                        <field name="unlink_scope" />
                        <field name="reassign_scope" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="action_crm_access_policy" model="ir.actions.act_window">
        <field name="name">CRM Access Policies</field>
        <field name="res_model">mobikey.crm.access.policy</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
    <menuitem id="menu_crm_access_policy" name="CRM Access Policies" parent="crm.crm_menu_config" action="action_crm_access_policy" groups="base.group_system" sequence="60" />
    <record id="deal_type_list" model="ir.ui.view">
        <field name="name">mobikey.deal.type.list</field>
        <field name="model">mobikey.deal.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" readonly="id" />
            </list>
        </field>
    </record>
    <record id="deal_type_form" model="ir.ui.view">
        <field name="name">mobikey.deal.type.form</field>
        <field name="model">mobikey.deal.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="code" readonly="id" />
                        <field name="sequence" />
                    </group>
                    <p>The Financing code retains its existing financing behavior. New options classify deals; financing remains controlled by Financing Required and payment terms.</p>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_deal_type" model="ir.actions.act_window">
        <field name="name">Deal Types</field>
        <field name="res_model">mobikey.deal.type</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_deal_type" name="Deal Types" parent="crm.crm_menu_config" action="action_deal_type" groups="sales_team.group_sale_manager,base.group_system" sequence="56" />
</odoo>
