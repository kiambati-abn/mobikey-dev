<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="mobikey_crm_lead_view_form" model="ir.ui.view">
    <field name="name">crm.lead.form.mobikey</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_lead_view_form" />
    <field name="priority">20</field>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="before">
        <group string="Customer need">
          <group>
            <field name="vehicle_type" />
            <field name="vehicle_condition" />
            <field name="intended_use" />
            <field name="demo_required" />
          </group>
          <group>
            <field name="purchase_timeframe" />
            <field name="budget_range" />
            <field name="deal_type" />
            <field name="financing_required" readonly="0" />
            <field name="trade_in" />
          </group>
        </group>
      </xpath>
      <xpath expr="//page[@name='internal_notes']" position="before">
        <page string="Qualification" name="mobikey_qualification">
          <group>
            <group>
              <field name="customer_type" />
              <field name="industry_type" />
              <field name="is_fleet_customer" />
              <field name="sales_region" />
              <field name="preferred_language" readonly="0" />
            </group>
            <group invisible="type != 'lead'">
              <field name="lead_status" />
              <field name="disqualification_reason" invisible="lead_status != 'disqualified'" required="lead_status == 'disqualified'" />
              <field name="disqualification_notes" invisible="lead_status != 'disqualified'" />
            </group>
          </group>
        </page>
      </xpath>
      <xpath expr="//page[@name='extra']//group[@name='categorization']/field[@name='referred']" position="after">
        <field name="walkin_location" />
      </xpath>
      <xpath expr="//page[@name='lead']//field[@name='referred']" position="after">
        <field name="walkin_location" />
      </xpath>
    </field>
  </record>
  <record id="mobikey_crm_lead_tree_view_leads" model="ir.ui.view">
    <field name="name">crm.lead.tree.leads.mobikey</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_case_tree_view_leads" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='tag_ids']" position="before">
        <field name="customer_type" optional="show" />
        <field name="vehicle_type" optional="show" />
        <field name="lead_status" optional="show" />
      </xpath>
    </field>
  </record>
  <record id="mobikey_crm_lead_tree_view_oppor" model="ir.ui.view">
    <field name="name">crm.lead.tree.oppor.mobikey</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_case_tree_view_oppor" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='tag_ids']" position="before">
        <field name="customer_type" optional="show" />
        <field name="vehicle_type" optional="show" />
      </xpath>
    </field>
  </record>
  <record id="mobikey_crm_lead_search_view" model="ir.ui.view">
    <field name="name">crm.lead.search.mobikey</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.view_crm_case_leads_filter" />
    <field name="arch" type="xml">
      <xpath expr="//filter[@name='inactive']" position="after">
        <separator />
        <filter string="Trade-In" name="trade_in" domain="[('trade_in', '=', True)]" />
        <separator />
        <filter string="Status: Qualified" name="status_qualified" domain="[('lead_status', '=', 'qualified')]" />
        <filter string="Status: Disqualified" name="status_disqualified" domain="[('lead_status', '=', 'disqualified')]" />
      </xpath>
      <xpath expr="//filter[@name='group_by_lead_properties']" position="after">
        <filter string="Country" name="group_country" context="{'group_by': 'country_id'}" />
        <filter string="Customer Type" name="group_customer_type" context="{'group_by': 'customer_type'}" />
        <filter string="Vehicle Type" name="group_vehicle_type" context="{'group_by': 'vehicle_type'}" />
        <filter string="Lead Status" name="group_lead_status" context="{'group_by': 'lead_status'}" />
      </xpath>
    </field>
  </record>
  <record id="mobikey_crm_opportunity_search_view" model="ir.ui.view">
    <field name="name">crm.lead.search.oppor.mobikey</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter" />
    <field name="arch" type="xml">
      <xpath expr="//filter[@name='group_by_lead_properties']" position="after">
        <filter string="Country" name="opp_group_country" context="{'group_by': 'country_id'}" />
        <filter string="Customer Type" name="opp_group_customer_type" context="{'group_by': 'customer_type'}" />
        <filter string="Vehicle Type" name="opp_group_vehicle_type" context="{'group_by': 'vehicle_type'}" />
      </xpath>
    </field>
  </record>
</odoo>
