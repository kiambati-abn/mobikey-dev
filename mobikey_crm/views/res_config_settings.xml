<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherit Form View to Modify it -->
    <record id="view_crm_config_settings_inherit_followup" model="ir.ui.view">
        <field name="name">crm.config.settings.followup.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <!-- Add inside CRM app -->
            <xpath expr="//app[@name='crm']" position="inside">

                <!-- New Follow-Up Block -->
                <block title="Follow-Up">

                    <setting string="Sales Person Follow-Up Days"
                             help="Number of days after which a follow-up activity will be scheduled for the salesperson when an opportunity is marked as WON.">
                        <field name="sales_followup_days"/>
                    </setting>

                    <setting string="After Sales Follow-Up Days"
                             help="Number of days after which a follow-up activity will be scheduled for the after-sales user when an opportunity is marked as WON.">
                        <field name="aftersales_followup_days"/>
                    </setting>

                </block>

            </xpath>
        </field>
    </record>
    <record id="res_config_settings_view_form_inherit_trade_in" model="ir.ui.view">
        <field name="name">res.config.settings.trade.in.threshold</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='partnership_settings']" position="after">
                <setting id="trade_in_threshold_setting" string="Trade-in Threshold"
                         help="Minimum margin percentage required for trade-in approval.">
                    <field name="trade_in_threshold"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>