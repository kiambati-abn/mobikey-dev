<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_jensales" model="ir.ui.view">
        <field name="name">product.template.form.inherit.jensales</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="model"/>
            </xpath>
            <xpath expr="//field[@name='standard_price']" position="attributes">
                <attribute name="groups">base.group_system,mobikey_crm.group_mobikey_country_director,mobikey_crm.group_mobikey_country_gm,mobikey_crm.group_mobikey_finance,mobikey_crm.group_mobikey_hq</attribute>
            </xpath>

        </field>
    </record>



</odoo>
