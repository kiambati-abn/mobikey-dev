    <!-- ══════════════════════════════════════════════════════
         ACCOUNT.PAYMENT.TERM — extend form view with financing_required
         ══════════════════════════════════════════════════════ -->
    <record id="account_payment_term_view_form_mobikey" model="ir.ui.view">
        <field name="name">account.payment.term.form.mobikey</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='early_discount']" position="before">
                <field name="financing_required"
                       help="When this payment term is selected on a quotation, the financing approval workflow is triggered automatically."/>
            </xpath>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════
         CRM CONFIGURATION MENU ITEMS
         ══════════════════════════════════════════════════════ -->
    <menuitem id="menu_mobikey_vehicle_type"
              name="Vehicle Types"
              parent="crm.crm_menu_config"
              action="action_mobikey_vehicle_type"
              sequence="50"/>

    <menuitem id="menu_mobikey_intended_use"
