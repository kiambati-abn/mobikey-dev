<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════
         VEHICLE TYPE
         ══════════════════════════════════════════════════════ -->
    <record id="mobikey_vehicle_type_view_list" model="ir.ui.view">
        <field name="name">mobikey.vehicle.type.list</field>
        <field name="model">mobikey.vehicle.type</field>
        <field name="arch" type="xml">
            <list string="Vehicle Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="mobikey_vehicle_type_view_form" model="ir.ui.view">
        <field name="name">mobikey.vehicle.type.form</field>
        <field name="model">mobikey.vehicle.type</field>
        <field name="arch" type="xml">
            <form string="Vehicle Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mobikey_vehicle_type" model="ir.actions.act_window">
        <field name="name">Vehicle Types</field>
        <field name="res_model">mobikey.vehicle.type</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

